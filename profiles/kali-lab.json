{
  "campaign_id": "camp_kali_lab",
  "schema_version": 1,
  "mode": "assessment",
  "root_goal": {
    "statement": "Assess the authorized lab hosts listed in scope.assets using Kali tools in the campaign container.",
    "success_predicate_ref": "authorized_lab_assessed"
  },
  "scope": {
    "assets": ["10.0.0.0/24", "lab.internal"],
    "workspace": "kali",
    "identities": ["operator"],
    "entries": ["https://lab.internal"],
    "exclusions": [],
    "profile": "kali-lab"
  },
  "policy_version": "p1-kali-1",
  "scope_version": "s-kali-1",
  "goal_version": "g-kali-1",
  "tool_allowlist": [
    "graph_query",
    "artifact_read",
    "submit_observation",
    "submit_fact",
    "submit_finding",
    "propose_plan",
    "propose_step",
    "finish_step",
    "finish_decision",
    "checkpoint",
    "kali_run",
    "kali_write",
    "playwright"
  ],
  "execution_profile": "kali",
  "model_policy": {
    "provider": "scripted",
    "model": "scripted",
    "thinking_level": "high",
    "allow_retry": false,
    "allow_model_fallback": false
  },
  "budget": {
    "currency": "USD",
    "price_version": "unknown",
    "max_cost_micro": null,
    "max_tokens": 10000000,
    "max_calls": 1000,
    "deadline_ms": null
  },
  "verification_policy": {
    "require_independent_verify": true,
    "oracle_id": "authorized-lab"
  },
  "coverage_policy": {
    "dimensions": ["asset", "method"],
    "mandatory_ids": ["http-probe", "headless-browser"]
  },
  "artifact_policy": {
    "max_bytes": 2000000,
    "retention_days": 30
  },
  "stop_policy": {
    "max_empty_reviews_per_progress_epoch": 2,
    "decide_debounce_ms": 0
  },
  "environment_revision": "env-1"
}
